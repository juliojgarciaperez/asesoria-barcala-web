---
interface Props {
  name: string;
  size?: number;
  class?: string;
  'aria-hidden'?: boolean | string;
}

const { name, size = 24, class: className = '', ...rest } = Astro.props;

// Lucide icons inline (subset). Stroke 1.75 for elegance.
