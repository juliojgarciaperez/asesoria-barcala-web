---
import { team } from '../data/team';
import { url } from '../utils/url';
---

<div class="team" id="equipo" aria-labelledby="equipo-title">
  <header class="team-head">
    <p class="eyebrow">El equipo</p>
    <h3 id="equipo-title">Las personas detrás de Barkala.</h3>
    <p class="team-lead">
      Dos asesores con trayectoria en finanzas, banca corporativa y gestión empresarial. Tu interlocutor
      es siempre directo: nada de intermediarios.
    </p>
  </header>

  <div class="team-grid">
    {team.map((member) => (
      <article class="member">
        <div class="member-photo">
          <img
            src={url(member.photo)}
            alt={`Retrato de ${member.name}`}
            width="900"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="member-body">
          <span class="member-role">{member.role}</span>
          <h4>{member.name}</h4>
          <p>{member.bio}</p>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .team {
    margin-top: var(--space-20);
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .team-head {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }
  .team-head h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    margin: 0 0 var(--space-3);
  }
  .team-lead {
    color: var(--color-text-mid);
    font-size: var(--fs-body-lg);
    margin: 0;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .member {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .member:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
  }

  .member-photo {
    aspect-ratio: 5 / 4;
    background: var(--color-bg-alt);
    overflow: hidden;
  }
  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    filter: saturate(0.95);
  }

  .member-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  @media (min-width: 960px) {
    .member-body {
      padding: var(--space-5);
    }
  }

  .member-role {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .member h4 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 1.2;
  }

  .member p {
    color: var(--color-text-mid);
    font-size: var(--fs-body-sm);
    line-height: 1.7;
    margin: 0;
    flex-grow: 1;
  }

  @media (min-width: 700px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .member { grid-template-columns: 1fr 1.2fr; }
    .member-photo { aspect-ratio: auto; height: 100%; }
  }
</style>
