---
import { site } from '../data/site';

const stats = [
  { value: `+${site.yearsExperience}`, label: `años en ${site.city}` },
  { value: `+${site.numClients}`, label: 'empresas y autónomos asesorados' },
  { value: '100%', label: 'gestión digital con AEAT y DEHú' },
];
---

<section class="trust" aria-labelledby="trust-title">
  <div class="container">
    <h2 id="trust-title" class="sr-only">Confianza</h2>

    <div class="trust-grid">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>

    <blockquote class="trust-quote">
      <p>
        "Buscamos establecer vínculos sólidos y duraderos con nuestros clientes, fundamentados en la
        confianza mutua."
      </p>
      <footer>— Asesoría Barkala</footer>
    </blockquote>
  </div>
</section>

<style>
  .trust {
    background: var(--color-primary);
    color: #fff;
    padding-block: var(--section-y);
    position: relative;
    overflow: hidden;
  }
  .trust::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px 300px at 10% 20%, rgba(255,255,255,0.06), transparent 70%),
      radial-gradient(600px 300px at 90% 80%, rgba(91, 143, 191, 0.18), transparent 70%);
    pointer-events: none;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
    position: relative;
  }

  .stat {
    text-align: center;
    padding: 0 var(--space-4);
  }

  .stat-value {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 1.5rem + 2vw, 3.25rem);
    font-weight: 500;
    line-height: 1;
    margin-bottom: var(--space-3);
    color: #fff;
  }
  .stat-label {
    color: var(--color-text-on-dark-soft);
    font-size: var(--fs-body-sm);
  }

  .trust-quote {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
  }
  .trust-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.125rem, 0.95rem + 0.7vw, 1.5rem);
    color: #fff;
    line-height: 1.5;
    margin: 0 0 var(--space-4);
  }
  .trust-quote footer {
    color: var(--color-text-on-dark-soft);
    font-size: var(--fs-body-sm);
    font-style: normal;
  }

  @media (min-width: 700px) {
    .trust-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
    .stat { border-right: 1px solid rgba(255, 255, 255, 0.12); }
    .stat:last-child { border-right: 0; }
  }
</style>
